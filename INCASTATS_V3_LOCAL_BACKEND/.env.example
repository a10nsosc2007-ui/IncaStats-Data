# CREA .env.local EN ESTA CARPETA (NO LO SUBAS A GITHUB)
# Copia aqui tus claves de The Odds API, solo en tu PC.
ODDS_API_KEYS=REEMPLAZA_CON_TUS_CLAVES_SEPARADAS_POR_COMA
# Selecciona UNA clave configurada; no se rotan automaticamente por limites.
INCA_ACTIVE_KEY_INDEX=1
INCA_PORT=8787
INCA_REGIONS=eu
INCA_REFRESH_HOURS=12
INCA_MAX_REQUESTS_PER_SYNC=12
INCA_PROP_EVENTS_PER_SYNC=4
INCA_PROP_MARKETS=player_shots,player_shots_on_target
INCA_SPORTS=soccer_uefa_champs_league,soccer_uefa_europa_league,soccer_uefa_europa_conference_league,soccer_conmebol_copa_libertadores
